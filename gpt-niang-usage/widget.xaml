<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPT 娘 · 额度用量" Width="350" Height="350" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        FontFamily="__GPTNIANG_FONT__" FontWeight="Medium" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale" TextOptions.TextHintingMode="Fixed">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#79659A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="6" Padding="3,1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="#EDE7F6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox x:Name="ScaleHost" Stretch="Uniform">
  <Canvas x:Name="AnimationStage" Width="378" Height="378">
  <Canvas x:Name="Root" Canvas.Left="14" Canvas.Top="14" Width="350" Height="350" RenderTransformOrigin="0.5,1">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="PressScale"/><ScaleTransform x:Name="FacingScale"/></TransformGroup></Canvas.RenderTransform>
    <Canvas x:Name="Bubble" Width="350" Height="239" Cursor="Hand" RenderTransformOrigin="0.4425,0.36">
      <Canvas.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Canvas.RenderTransform>
      <Path x:Name="BubbleShape" Fill="#FFFFFF" Stroke="#745A98" StrokeThickness="4"
            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 283,85 A 128,79 0 1 0 27,85 A 128,79 0 0 0 114,160 A 20,10 0 0 0 149,164 A 128,79 0 0 0 283,85 Z"/>
      <Grid x:Name="SceneText" Canvas.Left="47" Canvas.Top="18" Width="216" Height="118" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="TextFacingScale"/></Grid.RenderTransform>
      <Canvas x:Name="QuotaText" Width="216" Height="118" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Canvas x:Name="HeaderRow">
          <TextBlock x:Name="Header" Canvas.Left="58" Canvas.Top="4" Width="100" Text="剩余额度" TextAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" FontSize="17" FontWeight="Medium" Foreground="#745A98" IsHitTestVisible="False"/>
          <Button x:Name="Refresh" Canvas.Left="158" Canvas.Top="8" Width="22" Height="22" Foreground="#A08CAF" ToolTip="立即刷新额度" Cursor="Hand" Focusable="False">
  <Button.Style>
    <Style TargetType="Button">
      <Setter Property="Opacity" Value="0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Bubble}" Value="True"><Setter Property="Opacity" Value="0.6"/></DataTrigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="Foreground" Value="#745A98"/></Trigger>
      </Style.Triggers>
    </Style>
  </Button.Style>
  <Button.Template>
    <ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
        <Viewbox Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Canvas Width="16" Height="16">
            <Path Data="M 13,5.5 A 5.5,5.5 0 1 0 13.3,11 M 13,2 L 13,5.5 L 9.5,5.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.15" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Canvas>
        </Viewbox>
      </Grid>
    </ControlTemplate>
  </Button.Template>
</Button>
        </Canvas>
        <Canvas x:Name="QuotaColumns" Canvas.Left="14" Canvas.Top="30" Width="188" Height="83">
          <Canvas x:Name="ShortRow" Canvas.Top="0" Width="188" Height="37" IsHitTestVisible="False">
            <TextBlock x:Name="ShortLabel" Canvas.Top="6" Width="53" Text="5小时" FontSize="15" FontWeight="Medium" Foreground="#806791" TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="ShortLeft" Canvas.Left="53" Canvas.Top="-2" Width="65" Text="—" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold" Foreground="#745A98" TextAlignment="Center" TextWrapping="NoWrap"/>
            <TextBlock x:Name="ShortReset" Canvas.Left="120" Canvas.Top="10" Width="68" Text="等待数据" FontSize="14" Foreground="#806E91" TextAlignment="Right" TextWrapping="NoWrap"/>
            <Border Canvas.Top="33" Width="188" Height="4" Background="#EAE3F1" CornerRadius="2">
              <Border x:Name="ShortBar" Background="#A184C1" CornerRadius="2" Width="0" HorizontalAlignment="Left"/>
            </Border>
            <TextBlock x:Name="ShortUsed" Visibility="Collapsed" Text="已用 —"/>
          </Canvas>
          <Canvas x:Name="WeekRow" Canvas.Top="46" Width="188" Height="37" IsHitTestVisible="False">
            <TextBlock x:Name="WeekLabel" Canvas.Top="6" Width="53" Text="1周" FontSize="15" FontWeight="Medium" Foreground="#806791" TextAlignment="Left" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="WeekLeft" Canvas.Left="53" Canvas.Top="-2" Width="65" Text="—" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold" Foreground="#745A98" TextAlignment="Center" TextWrapping="NoWrap"/>
            <TextBlock x:Name="WeekReset" Canvas.Left="120" Canvas.Top="10" Width="68" Text="等待数据" FontSize="14" Foreground="#806E91" TextAlignment="Right" TextWrapping="NoWrap"/>
            <Border Canvas.Top="33" Width="188" Height="4" Background="#EAE3F1" CornerRadius="2">
              <Border x:Name="WeekBar" Background="#A184C1" CornerRadius="2" Width="0" HorizontalAlignment="Left"/>
            </Border>
            <TextBlock x:Name="WeekUsed" Visibility="Collapsed" Text="已用 —"/>
          </Canvas>        </Canvas>
        <TextBlock x:Name="Status" Visibility="Collapsed" Text="正在读取额度…"/>
      </Canvas>
        <TextBlock x:Name="QuoteText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="NoWrap" FontFamily="__GPTNIANG_FONT__" FontWeight="Medium" FontSize="20" Foreground="#745A98" IsHitTestVisible="False" Text="我在这儿，慢慢来就好。"/>
      </Grid>
    <Ellipse x:Name="LiveDot" Visibility="Collapsed" Canvas.Left="134" Canvas.Top="17" Width="4" Height="4" Fill="#9B86C1" IsHitTestVisible="False"/>
    </Canvas>
    <Ellipse x:Name="Tail" Canvas.Left="108" Canvas.Top="182" Width="25" Height="18" Fill="#FFFFFF" Stroke="#745A98" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="TailNear" Canvas.Left="142" Canvas.Top="214" Width="17" Height="12" Fill="#FFFFFF" Stroke="#745A98" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Image x:Name="Girl" Canvas.Left="142" Canvas.Top="142" Width="208" Height="208" Stretch="UniformToFill" Cursor="Hand" RenderOptions.BitmapScalingMode="HighQuality"
           ToolTip="点角色看额度；点气泡看语录，再点收起；拖动调整位置；右键设置"/>
    <Button x:Name="MenuButton" Canvas.Left="320" Canvas.Top="162" Width="24" Height="24"
            FontSize="15" Opacity="0" IsHitTestVisible="False" Background="#EDE7F6" ToolTip="挂件设置">
      <Viewbox Width="14" Height="14" Stretch="Uniform">
        <Canvas Width="16" Height="16" UseLayoutRounding="False" SnapsToDevicePixels="False">
          <Path x:Name="MenuIconLines" Data="M 2,4 L 14,4 M 2,8 L 14,8 M 2,12 L 14,12"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Canvas>
      </Viewbox>
    </Button>
  </Canvas>
  </Canvas>
  </Viewbox>
</Window>
