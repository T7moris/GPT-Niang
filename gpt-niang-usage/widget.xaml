<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPT 娘 · 额度用量" Width="350" Height="350" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="{x:Null}"
        ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="QuotaNumberRow" TargetType="Grid">
      <Setter Property="Height" Value="22"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=ShortRow}" Value="Collapsed"><Setter Property="Height" Value="30"/></DataTrigger>
        <DataTrigger Binding="{Binding Visibility, ElementName=WeekRow}" Value="Collapsed"><Setter Property="Height" Value="30"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuotaLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17"/><Setter Property="LineHeight" Value="22"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=ShortRow}" Value="Collapsed"><Setter Property="FontSize" Value="20"/><Setter Property="LineHeight" Value="28"/></DataTrigger>
        <DataTrigger Binding="{Binding Visibility, ElementName=WeekRow}" Value="Collapsed"><Setter Property="FontSize" Value="20"/><Setter Property="LineHeight" Value="28"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuotaValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/><Setter Property="LineHeight" Value="22"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=ShortRow}" Value="Collapsed"><Setter Property="FontSize" Value="28"/><Setter Property="LineHeight" Value="30"/></DataTrigger>
        <DataTrigger Binding="{Binding Visibility, ElementName=WeekRow}" Value="Collapsed"><Setter Property="FontSize" Value="28"/><Setter Property="LineHeight" Value="30"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuotaReset" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="LineHeight" Value="12"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=ShortRow}" Value="Collapsed"><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="17"/></DataTrigger>
        <DataTrigger Binding="{Binding Visibility, ElementName=WeekRow}" Value="Collapsed"><Setter Property="FontSize" Value="14"/><Setter Property="LineHeight" Value="17"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="QuotaTrack" TargetType="Border">
      <Setter Property="Width" Value="168"/><Setter Property="Height" Value="5"/>
      <Setter Property="Background" Value="#EAE4F3"/><Setter Property="CornerRadius" Value="2.5"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Visibility, ElementName=ShortRow}" Value="Collapsed"><Setter Property="Width" Value="184"/><Setter Property="Height" Value="9"/><Setter Property="CornerRadius" Value="4.5"/></DataTrigger>
        <DataTrigger Binding="{Binding Visibility, ElementName=WeekRow}" Value="Collapsed"><Setter Property="Width" Value="184"/><Setter Property="Height" Value="9"/><Setter Property="CornerRadius" Value="4.5"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#79659A"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="ButtonBody" Background="{TemplateBinding Background}" CornerRadius="6" Padding="3,1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBody" Property="Background" Value="#EDE7F6"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Viewbox x:Name="ScaleHost" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
  <Canvas x:Name="AnimationStage" Width="378" Height="378">
  <Canvas x:Name="Root" Canvas.Left="14" Canvas.Top="14" Width="350" Height="350" RenderTransformOrigin="0.5,1">
    <Canvas.RenderTransform><TransformGroup><ScaleTransform x:Name="PressScale"/><ScaleTransform x:Name="FacingScale"/></TransformGroup></Canvas.RenderTransform>
    <Canvas x:Name="Bubble" Width="350" Height="239" Cursor="Hand" RenderTransformOrigin="0.4425,0.36">
      <Canvas.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Canvas.RenderTransform>
      <Path x:Name="BubbleShape" Fill="#FFFFFF" Stroke="#745A98" StrokeThickness="4"
            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
            Data="M 283,85 A 128,79 0 1 0 27,85 A 128,79 0 0 0 114,160 A 20,10 0 0 0 149,164 A 128,79 0 0 0 283,85 Z"/>
      <Grid x:Name="SceneText" Canvas.Left="63" Canvas.Top="22" Width="184" Height="115" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><ScaleTransform x:Name="TextFacingScale"/></Grid.RenderTransform>
      <StackPanel x:Name="QuotaText" HorizontalAlignment="Center">
        <StackPanel.Style>
          <Style TargetType="StackPanel">
            <Setter Property="Width" Value="168"/><Setter Property="VerticalAlignment" Value="Top"/><Setter Property="Margin" Value="0,21,0,0"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Visibility, ElementName=ShortRow}" Value="Collapsed"><Setter Property="Width" Value="184"/><Setter Property="Margin" Value="0,34,0,0"/></DataTrigger>
              <DataTrigger Binding="{Binding Visibility, ElementName=WeekRow}" Value="Collapsed"><Setter Property="Width" Value="184"/><Setter Property="Margin" Value="0,34,0,0"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </StackPanel.Style>
        <TextBlock x:Name="Header" Visibility="Collapsed" Text="剩余额度" ToolTip="重置时间按当前机器的本地时间显示"/>
        <StackPanel x:Name="ShortRow">
        <Grid Style="{StaticResource QuotaNumberRow}">
          <TextBlock x:Name="ShortLabel" Style="{StaticResource QuotaLabel}" Text="5 小时" FontWeight="Normal" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Foreground="#76638D"/>
          <TextBlock x:Name="ShortLeft" Style="{StaticResource QuotaValue}" Text="—" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#745A98"/>
        </Grid>
        <Border Style="{StaticResource QuotaTrack}">
          <Border x:Name="ShortBar" Background="#AA95CD" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Width="0" HorizontalAlignment="Left"/>
        </Border>
        <TextBlock x:Name="ShortReset" Style="{StaticResource QuotaReset}" Text="等待额度数据" LineStackingStrategy="BlockLineHeight" Foreground="#A1A4AD" Opacity="0.65"/>
        <TextBlock x:Name="ShortUsed" Visibility="Collapsed" Text="已用 —"/>
        </StackPanel>
        <StackPanel x:Name="WeekRow" Margin="0,1,0,0">
        <Grid Style="{StaticResource QuotaNumberRow}">
          <TextBlock x:Name="WeekLabel" Style="{StaticResource QuotaLabel}" Text="每周" FontWeight="Normal" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" Foreground="#76638D"/>
          <TextBlock x:Name="WeekLeft" Style="{StaticResource QuotaValue}" Text="—" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Segoe UI" LineStackingStrategy="BlockLineHeight" FontWeight="Bold" Foreground="#745A98"/>
        </Grid>
        <Border Style="{StaticResource QuotaTrack}">
          <Border x:Name="WeekBar" Background="#AA95CD" CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type Border}}}" Width="0" HorizontalAlignment="Left"/>
        </Border>
        <TextBlock x:Name="WeekReset" Style="{StaticResource QuotaReset}" Text="等待额度数据" LineStackingStrategy="BlockLineHeight" Foreground="#A1A4AD" Opacity="0.65"/>
        <TextBlock x:Name="WeekUsed" Visibility="Collapsed" Text="已用 —"/>
        </StackPanel>
        <TextBlock x:Name="Status" Visibility="Collapsed" Text="正在读取额度…"/>
      </StackPanel>
        <TextBlock x:Name="QuoteText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="20" FontWeight="Bold" LineHeight="25" Foreground="#745A98" IsHitTestVisible="False" Text="我在这儿，慢慢来就好。"/>
      </Grid>
    <Ellipse x:Name="LiveDot" Visibility="Collapsed" Canvas.Left="134" Canvas.Top="17" Width="4" Height="4" Fill="#9B86C1" IsHitTestVisible="False"/>
    </Canvas>
    <Ellipse x:Name="Tail" Canvas.Left="108" Canvas.Top="182" Width="25" Height="18" Fill="#FFFFFF" Stroke="#745A98" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Ellipse x:Name="TailNear" Canvas.Left="142" Canvas.Top="214" Width="17" Height="12" Fill="#FFFFFF" Stroke="#745A98" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
    </Ellipse>
    <Image x:Name="Girl" Canvas.Left="142" Canvas.Top="142" Width="208" Height="208" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
           ToolTip="点角色看额度；点气泡看语录，再点收起；拖动调整位置；右键设置"/>
    <Canvas x:Name="RefreshHost" Width="350" Height="239" Panel.ZIndex="10" RenderTransformOrigin="0.4425,0.36"
            Visibility="{Binding Visibility, ElementName=Bubble}" Opacity="{Binding Opacity, ElementName=Bubble}"
            IsHitTestVisible="{Binding IsHitTestVisible, ElementName=Bubble}" RenderTransform="{Binding RenderTransform, ElementName=Bubble}">
      <Button x:Name="Refresh" Canvas.Left="141" Canvas.Top="134" Width="28" Height="26" Foreground="#A6ADB8" Opacity="0.7" ToolTip="立即刷新额度">
        <Grid Width="18" Height="18" IsHitTestVisible="False">
          <Path Data="M 15,10.5 A 6.25,6.25 0 1 1 14.8,5.2 M 10.9,5.2 L 14.8,5.2 L 14.8,1.3"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
        </Grid>
      </Button>
    </Canvas>
    <Button x:Name="MenuButton" Canvas.Left="320" Canvas.Top="162" Width="24" Height="24" Content="☰"
            FontSize="15" Opacity="0" IsHitTestVisible="False" Background="#EDE7F6" ToolTip="挂件设置"/>
  </Canvas>
  </Canvas>
  </Viewbox>
</Window>
